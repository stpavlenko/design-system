# Адрес VPS с Selenoid и MinIO (обязательно; для CI — repository variable VPS_HOST)
VPS_HOST=<IP_вашего_VPS>

# MinIO / S3
S3_BUCKET=testplane-bundles
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=changeme

# Локальный сервер сборки тестовых бандлов
TESTS_SERVER_PORT=3000
TESTS_SERVER_URL=http://localhost:3000

# Необязательно: переопределить URL, если порты или схема отличаются от стандартных
# SELENOID_URL=http://<IP_вашего_VPS>:4444/wd/hub
# S3_ENDPOINT=http://<IP_вашего_VPS>:9000
# S3_BASE_URL=http://<IP_вашего_VPS>:9000/testplane-bundles
